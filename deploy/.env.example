# Settings for the pull-only stack in this folder.
# Copy to .env (next to docker-compose.yml), set SEARXNG_SECRET, then run:
#   docker compose up -d
# Every variable except SEARXNG_SECRET falls back to the default shown here.

# ── Images ──────────────────────────────────────────────────────────────────
# Images pulled from Docker Hub: <namespace>/disinfo-{app,ollama,searxng}:<tag>.
IMAGE_NAMESPACE=gammarase
IMAGE_TAG=latest

# ── SearXNG ─────────────────────────────────────────────────────────────────
# Required. Secret key of SearXNG; generate with: openssl rand -hex 32
SEARXNG_SECRET=
# Proxy result images through SearXNG (true/false).
SEARXNG_IMAGE_PROXY=true

# ── Ollama ──────────────────────────────────────────────────────────────────
# Model pulled by ollama on first start and used by app. qwen3:14b needs about
# 10 GB of GPU memory next to app's ~2-3 GB; on smaller cards pick qwen3:8b.
# With docker-compose.no-gpu.yml the model runs on CPU: pick qwen3:4b or smaller.
OLLAMA_MODEL=qwen3:14b
# How long ollama keeps the model loaded after the last request.
OLLAMA_KEEP_ALIVE=30m

# ── App ─────────────────────────────────────────────────────────────────────
# Host port of the web app. Without basic auth (below), bind to localhost only
# with APP_PORT=127.0.0.1:8000 or put the app behind a reverse proxy.
APP_PORT=8000
# HTTP Basic auth for the web page and API (the health check stays open).
# Set both to enable; leave both empty to disable. Basic auth sends the
# password with every request, so use HTTPS (a reverse proxy) beyond a LAN.
API_BASIC_AUTH_USERNAME=
API_BASIC_AUTH_PASSWORD=
# Ollama URL used by app inside the stack.
OLLAMA_BASE_URL=http://ollama:11434
# SearXNG URL used by app inside the stack.
SEARCH_BASE_URL=http://searxng:8080
# Reranker device: cuda, or cpu to keep app's models off the GPU (frees GPU memory).
# docker-compose.no-gpu.yml always uses cpu.
RETRIEVAL_DEVICE=cuda
# Web evidence cache: read_write | read_only | off.
RETRIEVAL_CACHE_MODE=read_write
# Minimum seconds between searches (lower it for a private, unthrottled SearXNG).
SEARCH_MIN_INTERVAL_SECONDS=210
# Source policy mode: strict | lenient | off.
SOURCE_POLICY_MODE=strict
# Log level: DEBUG | INFO | WARNING | ERROR.
LOGGING_LEVEL=INFO
# Longest accepted text, in characters.
API_MAX_TEXT_CHARS=20000
# Submissions are rejected (503) once this many checks are queued.
API_MAX_QUEUED=20
# Longest long-poll wait, in seconds.
API_MAX_WAIT_SECONDS=30
# Optional Hugging Face token for faster, un-throttled model downloads.
HF_TOKEN=
